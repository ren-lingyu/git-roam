+static char *batch_canonical_path(const char *path)
+{
+	struct strbuf resolved = STRBUF_INIT;
+
+	if (!strbuf_realpath_forgiving(&resolved, path, 0)) {
+		strbuf_release(&resolved);
+		return NULL;
+	}
+	return strbuf_detach(&resolved, NULL);
+}
+
+/* Only remove a new, empty, unmodified worktree. Never remove user files. */
+static int batch_remove_new_worktree(struct batch_created *item)
+{
+	struct strbuf dotgit = STRBUF_INIT;
+	struct strbuf admin = STRBUF_INIT;
+	const char *gitdir;
+	char *canonical_admin;
+	int read_error;
+	struct stat dotgit_stat;
+	DIR *dir;
+	struct dirent *d;
+	int safe = 1;
+	int ret = -1;
+
+	strbuf_addf(&dotgit, "%s/.git", item->path);
+	dir = opendir(item->path);
+	if (!dir)
+		goto done;
+	while ((d = readdir_skip_dot_and_dotdot(dir)) != NULL) {
+		if (strcmp(d->d_name, ".git")) {
+			safe = 0;
+			break;
+		}
+	}
+	closedir(dir);
+	if (!safe || lstat(dotgit.buf, &dotgit_stat) ||
+	    !S_ISREG(dotgit_stat.st_mode))
+		goto done;
+	repo_common_path_append(the_repository, &admin, "worktrees/%s", item->id);
+	/* Git resolves both absolute and relative gitfile links. Do not remove
+	 * anything if the link no longer points to our own worktree. */
+	gitdir = read_gitfile_gently(dotgit.buf, &read_error);
+	canonical_admin = real_pathdup(admin.buf, 0);
+	if (!gitdir || !canonical_admin || fspathcmp(gitdir, canonical_admin)) {
+		free(canonical_admin);
+		goto done;
+	}
+	free(canonical_admin);
+	if (unlink(dotgit.buf) || rmdir(item->path))
+		goto done;
+	ret = delete_git_dir(item->id);
+done:
+	if (ret)
+		warning("could not safely roll back worktree at '%s'; manual recovery needed",
+			item->path);
+	strbuf_release(&dotgit);
+	strbuf_release(&admin);
+	return ret;
+}
+
+static void batch_rollback(void)
+{
+	struct worktree_batch_state *state = active_worktree_batch;
+
+	if (!state || !state->rollback_needed)
+		return;
+	for (size_t i = state->created_nr; i > 0; i--)
+		batch_remove_new_worktree(&state->created[i - 1]);
+	state->rollback_needed = 0;
+}
+
+static void batch_rollback_on_signal(int signo)
+{
+	batch_rollback();
+	sigchain_pop(signo);
+	raise(signo);
+}
