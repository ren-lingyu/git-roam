+/* Read absolute-path<TAB>existing-branch lines from stdin. */
+static int add_batch_worktrees(const struct add_opts *opts)
+{
+	struct worktree_batch_state state = {
+		.paths = STRMAP_INIT,
+		.branches = STRMAP_INIT,
+	};
+	struct worktree **existing = get_worktrees();
+	struct strbuf line = STRBUF_INIT;
+	struct strbuf ref = STRBUF_INIT;
+	int ret = 0;
+
+	for (int i = 0; existing[i]; i++) {
+		char *canonical = real_pathdup(existing[i]->path, 0);
+		if (canonical) {
+			strmap_put(&state.paths, canonical,
+				   xstrdup(existing[i]->path));
+			free(canonical);
+		}
+	}
+	active_worktree_batch = &state;
+	while (strbuf_getline(&line, stdin) != EOF) {
+		char *sep = strchr(line.buf, '\t');
+		const char *branch;
+
+		if (!sep || !sep[1])
+			die("batch input must be absolute-path<TAB>branch");
+		*sep = 0;
+		branch = sep + 1;
+		if (!is_absolute_path(line.buf))
+			die("batch worktree path must be absolute");
+		if (check_branch_ref(&ref, branch) ||
+		    !refs_ref_exists(get_main_ref_store(the_repository), ref.buf))
+			die("batch branch does not exist or is invalid: '%s'", branch);
+		if (add_worktree(line.buf, branch, opts)) {
+			ret = 1;
+			break;
+		}
+		strbuf_reset(&ref);
+	}
+	active_worktree_batch = NULL;
+	strbuf_release(&line);
+	strbuf_release(&ref);
+	strmap_clear(&state.paths, 1);
+	strmap_clear(&state.branches, 1);
+	free_worktrees(existing);
+	return ret;
+}
