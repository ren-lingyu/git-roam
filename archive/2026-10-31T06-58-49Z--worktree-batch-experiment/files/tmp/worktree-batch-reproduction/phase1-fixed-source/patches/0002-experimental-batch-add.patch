+/* Experimental Git-roam prototype, not a production/public Git interface. */
+struct worktree_batch_state {
+	struct strmap paths;
+	struct strmap branches;
+};
+
+static struct worktree_batch_state *active_worktree_batch;
+
+static void batch_check_candidate_path(const char *path)
+{
+	char *canonical;
+
+	if (file_exists(path) && !is_empty_dir(path))
+		die("batch worktree destination is not empty: '%s'", path);
+	canonical = real_pathdup(path, 0);
+	if (!canonical)
+		die("cannot resolve batch worktree path: '%s'", path);
+	if (strmap_contains(&active_worktree_batch->paths, canonical))
+		die("batch worktree path already registered: '%s'", path);
+	free(canonical);
+}
+
+static void batch_check_branch(const char *branch)
+{
+	const char *other = branch_checked_out(branch);
+
+	if (!other)
+		other = strmap_get(&active_worktree_batch->branches, branch);
+	if (other)
+		die("batch worktree branch '%s' already used at '%s'",
+		    branch, other);
+}
+
+static void batch_record_created(const char *path, const char *branch)
+{
+	char *canonical = real_pathdup(path, 0);
+
+	if (!canonical)
+		BUG("cannot resolve newly created worktree path");
+	strmap_put(&active_worktree_batch->paths, canonical, xstrdup(path));
+	strmap_put(&active_worktree_batch->branches, branch, xstrdup(path));
+	free(canonical);
+}
