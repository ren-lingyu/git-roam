cabal-version: 3.0
name:          git-roam
version:       0.1.0
synopsis:      Git Roam
license:       MIT
build-type:    Simple

library
  hs-source-dirs:   src
  exposed-modules:
    GitRoam.Application.Checkpoint
    GitRoam.Application.Create
    GitRoam.Application.Delete
    GitRoam.Application.Deploy
    GitRoam.Application.Discard
    GitRoam.Application.Inspect
    GitRoam.Application.Protection
    GitRoam.Application.Undeploy
    GitRoam.Application.Worktree
    GitRoam.Cli
    GitRoam.Git
    GitRoam.Git.Objects
    GitRoam.Git.Worktrees
    GitRoam.ObjectId
    GitRoam.Output
    GitRoam.Protocol.Discard
    GitRoam.Protocol.History
    GitRoam.Protocol.Identity
    GitRoam.Protocol.Objects
    GitRoam.Protocol.Repository
    GitRoam.Protocol.V2.History
    GitRoam.Protocol.V2.Repository
    GitRoam.Repository
    GitRoam.Worktree.Paths

  other-modules:
    GitRoam.BuildInfo
    GitRoam.Git.Batch
    Paths_git_roam

  autogen-modules:  Paths_git_roam
  build-depends:
    , aeson
    , async
    , base               >=4.16 && <5
    , base64-bytestring
    , bytestring
    , cborg
    , containers
    , cryptohash-sha256
    , directory
    , filepath
    , process
    , template-haskell
    , text
    , transformers
    , unix
    , uuid

  default-language: Haskell2010
  ghc-options:      -Wall

executable git-roam
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base        >=4.16 && <5
    , bytestring
    , git-roam
    , text

  default-language: Haskell2010
  ghc-options:      -Wall -threaded

test-suite unit-tests
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Unit.hs
  other-modules:    TestSupport
  build-depends:
    , base        >=4.16 && <5
    , bytestring
    , directory
    , git-roam
    , text

  default-language: Haskell2010
  ghc-options:      -Wall

